{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nubooks",
  "version": "0.1.1",
  "identifier": "com.nubooks.reader",
  "build": {
    "beforeDevCommand": "node scripts/ensure-vite.mjs",
    "devUrl": "http://localhost:8443",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Nubooks", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 620 }],
    "security": {
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
